# Copy this file to .env and adjust values. Never commit the real .env.
# cp .env.example .env

# ---------- Backend ----------
APP_NAME=tkxdpm_2
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# SQLite database (relative paths are resolved from the project root).
DATABASE_URL=sqlite:///./data/app.db

# IANA timezone used when a request does not specify one.
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# How long a schedule may be, in minutes (min 15 phút, max 7 ngày).
MIN_DURATION_MINUTES=15
MAX_DURATION_MINUTES=10080

# Reminder notifications: background dispatch every N seconds.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_POLL_SECONDS=30

# Comma-separated list of origins allowed by CORS (frontend dev server).
CORS_ORIGINS=http://localhost:5173

# Secrets: put real values only in .env, never here.
SECRET_KEY=change-me

# ---------- Google Calendar (tùy chọn) ----------
# disabled = tắt (mặc định, app vẫn chạy bình thường)
# memory   = bản mô phỏng chạy trong tiến trình, dùng để demo/test, KHÔNG đồng bộ thật
# google   = dùng Google Calendar API thật (cần OAuth, xem README)
GOOGLE_CALENDAR_MODE=disabled
GOOGLE_CALENDAR_ID=primary
# Đường dẫn tới credential; cả hai đều nằm ngoài Git.
GOOGLE_CREDENTIALS_FILE=secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
# Tiền tố id sự kiện Google (chỉ ký tự 0-9 và a-v).
GOOGLE_EVENT_ID_PREFIX=tkdpm

# ---------- Frontend (Vite: only VITE_* vars are exposed to the browser) ----------
VITE_API_BASE_URL=http://127.0.0.1:8001
